-muted);font-size:.85rem}\n\n  /* how it works numbered steps */\n  .steps{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:22px}\n  .step{border:1px solid var(--line);padding:24px 24px 24px 24px;background:var(--panel)}\n  .step .idx{font-family:var(--serif);font-size:2.6rem;font-weight:800;color:var(--green);line-height:1;margin-bottom:12px}\n  .step h3{font-family:var(--serif);font-size:1.15rem;margin:0 0 8px}\n  .step p{margin:0;color:var(--muted);font-size:.9rem}\n\n  /* clients note */\n  .clients{border:1px dashed var(--line);padding:30px 32px;background:var(--panel);display:grid;grid-template-columns:1fr;gap:16px}\n  .clients h3{font-family:var(--serif);font-size:1.3rem;margin:0}\n  .clients p{margin:0;color:var(--muted)}\n  .platforms{display:flex;flex-wrap:wrap;gap:10px;margin-top:6px}\n  .platforms span{font-family:var(--mono);font-size:.76rem;letter-spacing:.06em;border:1px solid var(--line);padding:7px 13px;color:var(--green-dim)}\n\n  /* FAQ two-column */\n  .faq{columns:2;column-gap:44px}\n  @media(max-width:760px){.faq{columns:1}}\n  .qa{break-inside:avoid;margin:0 0 26px;padding-bottom:22px;border-bottom:1px solid var(--line)}\n  .qa dt{font-family:var(--serif);font-size:1.08rem;color:var(--text);margin:0 0 8px}\n  .qa dt::before{content:\"Q \";color:var(--green);font-family:var(--mono);font-size:.8rem;letter-spacing:.1em}\n  .qa dd{margin:0;color:var(--muted);font-size:.92rem}\n  .qa dd::before{content:\"A \";color:var(--green-dim);font-family:var(--mono);font-size:.8rem;letter-spacing:.1em}\n\n  footer{padding:56px 0 70px;border-top:1px solid var(--line)}\n  .foot-grid{display:flex;flex-wrap:wrap;justify-content:space-between;gap:24px;align-items:flex-end}\n  .foot-brand{font-family:var(--serif);font-size:1.5rem;font-weight:800}\n  .foot-brand .dot{color:var(--green)}\n  .foot-meta{font-family:var(--mono);font-size:.74rem;color:var(--muted);letter-spacing:.06em;text-align:right}\n\n  @media(max-width:820px){\n    .hero-grid{grid-template-columns:1fr}\n    .index-card{justify-self:stretch;max-width:none}\n    .hero{padding:64px 0 54px}\n  }\n</style><header class=\"top\">\n  <div class=\"wrap\">\n    <div class=\"crumb\"><b>环球加速</b><span class=\"sep\">/</span><span>网络方案</span><span class=\"sep\">/</span><span>套餐 · 用法 · 常见问题</span></div>\n    <nav class=\"toc\" aria-label=\"页面目录\">\n      <a href=\"#why\">为什么选它</a>\n      <a href=\"#plans\">套餐对比</a>\n      <a href=\"#how\">使用流程</a>\n      <a href=\"#clients\">客户端支持</a>\n      <a href=\"#faq\">常见问题</a>\n    </nav>\n  </div>\n</header>\n\n<main>\n\n  \n  <section class=\"hero\">\n    <div class=\"wrap hero-grid\">\n      <div>\n        <p class=\"kicker\">Cross-border Network · Since Day One</p>\n        <h1 class=\"brand\">环球加速 · 环球<span class=\"dot\">·</span>加速</h1>\n        <p class=\"lede\">把“连得上、看得顺、玩得稳”拆开来看，每一项都需要一条更合适的路。环球加速按用途分档，让你只为真正需要的部分付费。</p>\n        <div class=\"cta-row\">\n          <a class=\"btn\" href=\"#plans\">查看三档套餐</a>\n          <a class=\"btn ghost\" href=\"#how\">三分钟搞懂怎么用</a>\n        </div>\n      </div>\n\n      <aside class=\"index-card\" aria-label=\"本页导览\">\n        <h2>On This Page</h2>\n        <ul class=\"index-list\">\n          <li><span class=\"no\">01</span><span class=\"txt\"><strong>适合谁</strong><small>跨境办公 / 海外流媒体 / 联机游戏</small></span></li>\n          <li><span class=\"no\">02</span><span class=\"txt\"><strong>怎么选</strong><small>基础版 · 旗舰版 · 团队版横向对照</small></span></li>\n          <li><span class=\"no\">03</span><span class=\"txt\"><strong>怎么开始</strong><small>订阅到多设备登录的四步流程</small></span></li>\n          <li><span class=\"no\">04</span><span class=\"txt\"><strong>常见疑问</strong><small>流量、设备、节点与售后的问答合集</small></span></li>\n        </ul>\n      </aside>\n    </div>\n  </section>\n\n  \n  <section class=\"block\" id=\"why\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <p class=\"sec-tag\">Why It Matters</p>\n        <h2 class=\"sec-title\">不是所有需求，<em>都值得同一种配置</em></h2>\n        <p class=\"sec-sub\">看一部剧、开一场跨国会议、打一局排位赛，对线路的耐心完全不同。下面四件事，是决定你该选哪一档的关键变量。</p>\n      </div>\n      <div class=\"cards\">\n        <article class=\"card\">\n          <h3>流量给多少</h3>\n          <p>轻度浏览与偶尔追剧用不完大额度；持续高清串流和下载才会逼近上限。先估算你的月用量，再决定档位。</p>\n          <span class=\"num\">01</span>\n        </article>\n        <article class=\"card\">\n          <h3>几台设备同时在线</h3>\n          <p>手机、笔电、平板、家里电视往往一起挂着。并发数不够时，新设备会被挤下线——这是最容易被忽略的一项。</p>\n          <span class=\"num\">02</span>\n        </article>\n        <article class=\"card\">\n          <h3>要不要专线优化</h3>\n          <p>普通池足以应付网页与视频；实时性强的联机游戏与低延迟会议，则受益于 IPLC 这类专线路径。</p>\n          <span class=\"num\">03</span>\n        </article>\n        <article class=\"card\">\n          <h3>谁来兜底售后</h3>\n          <p>个人用户自助排障即可；团队与业务场景更需要优先工单或专属对接，避免问题卡在排队里。</p>\n          <span class=\"num\">04</span>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"block\" id=\"plans\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <p class=\"sec-tag\">Compare Side by Side</p>\n        <h2 class=\"sec-title\">三档套餐，<em>一表看清差别</em></h2>\n        <p class=\"sec-sub\">按月付或按年付均可，年付价格已折算为整年金额。绿色标记为当前推荐档。</p>\n      </div>\n\n      <div class=\"table-scroll\">\n        <table class=\"plans\">\n          <thead>\n            <tr>\n              <th>对比项</th>\n              <th>基础版</th>\n              <th class=\"col-flag\"><span class=\"ribbon\">推荐</span>旗舰版</th>\n              <th>团队版</th>\n            </tr>\n          </thead>\n          <tbody>\n            <tr>\n              <th>月费 / 年费</th>\n              <td><span class=\"price-cell\">¥15<small>按年付 ¥150/年</small></span></td>\n              <td><span class=\"price-cell\">¥35<small>按年付 ¥350/年</small></span></td>\n              <td><span class=\"price-cell\">¥85<small>按年付 ¥850/年</small></span></td>\n            </tr>\n            <tr>\n              <th>每月流量</th>\n              <td class=\"feat\">100GB 极速流量</td>\n              <td class=\"feat\">300GB 极速流量</td>\n              <td class=\"feat\">1000GB 极速流量</td>\n            </tr>\n            <tr>\n              <th>同时在线设备</th>\n              <td class=\"feat\">最多 3 台</td>\n              <td class=\"feat\">最多 5 台</td>\n              <td class=\"feat\">最多 20 台</td>\n            </tr>\n            <tr>\n              <th>流媒体解锁</th>\n              <td class=\"feat\">基础流媒体</td>\n              <td class=\"feat\">全节点原生解锁</td>\n              <td class=\"feat\">全节点原生解锁</td>\n            </tr>\n            <tr>\n              <th>线路类型</th>\n              <td class=\"feat\">普通线路节点池</td>\n              <td class=\"feat\">IPLC 专线游戏加速优化</td>\n              <td class=\"feat\">VIP 专属高带宽节点</td>\n            </tr>\n            <tr>\n              <th>企业 / 定制能力</th>\n              <td class=\"feat miss\">—</td>\n              <td class=\"feat miss\">—</td>\n              <td class=\"feat\">支持企业定制路由</td>\n            </tr>\n            <tr>\n              <th>技术支持</th>\n              <td class=\"feat miss\">标准渠道</td>\n              <td class=\"feat\">7×24 优先工单</td>\n              <td class=\"feat\">专属客户经理</td>\n            </tr>\n          </tbody>\n        </table>\n      </div>\n      <p class=\"plans-note\">提示：若你主要用途是高清串流与多人共用，旗舰版的流量与并发更从容；纯个人轻度使用，基础版通常够用；需要统一管理与定制路由的团队，直接看团队版。</p>\n    </div>\n  </section>\n\n  \n  <section class=\"block\" id=\"how\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <p class=\"sec-tag\">Getting Started</p>\n        <h2 class=\"sec-title\">从订阅到多设备，<em>只需四步</em></h2>\n        <p class=\"sec-sub\">下面的顺序适用于任意一档套餐，无需改动系统设置即可完成接入。</p>\n      </div>\n      <div class=\"steps\">\n        <div class=\"step\">\n          <div class=\"idx\">1</div>\n          <h3>选择档位</h3>\n          <p>按上面的用量与并发估算，挑一个最贴近需求的版本，月付或年付由你决定。</p>\n        </div>\n        <div class=\"step\">\n          <div class=\"idx\">2</div>\n          <h3>获取接入信息</h3>\n          <p>订阅后你会拿到对应设备的连接入口，用于在客户端中添加账户。</p>\n        </div>\n        <div class=\"step\">\n          <div class=\"idx\">3</div>\n          <h3>添加并登录</h3>\n          <p>在手机、电脑等设备分别导入配置，确认在线数量不超过套餐允许的同时在线数。</p>\n        </div>\n        <div class=\"step\">\n          <div class=\"idx\">4</div>\n          <h3>按需切换线路</h3>\n          <p>看视频走通用节点、玩游戏切优化线路，遇到异常先换节点再排查其他环节。</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"block\" id=\"clients\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <p class=\"sec-tag\">Supported Devices</p>\n        <h2 class=\"sec-title\">一套账号，<em>覆盖日常主力设备</em></h2>\n        <p class=\"sec-sub\">具体安装包与下载地址以你订阅后收到的官方通知为准，此处不预先提供未经确认的链接。</p>\n      </div>\n      <div class=\"clients\">\n        <h3>可接入的平台</h3>\n        <p>环球加速面向常见的桌面与移动终端设计，同一份套餐可在允许的并发数内跨设备登录。</p>\n        <div class=\"platforms\">\n          <span>Windows</span><span>macOS</span><span>iOS</span><span>Android</span><span>TV 端</span>\n        </div>\n        <p>如需某平台的具体安装步骤，请在订阅后查阅随附的使用说明，或在“常见问题”中查看对应解答。</p>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"block\" id=\"faq\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <p class=\"sec-tag\">Questions &amp; Answers</p>\n        <h2 class=\"sec-title\">下单前，<em>多半会问这几句</em></h2>\n        <p class=\"sec-sub\">以下回答只基于本页公开的套餐信息，未涉及的性能指标与承诺不作推测。</p>\n      </div>\n\n      <dl class=\"faq\">\n        <div class=\"qa\">\n          <dt>我该怎么判断自己该选哪一档？</dt>\n          <dd>先看两个数字：每月大概用多少流量、平时有几台设备同时挂着。轻度浏览且一两台设备选基础版；高清串流加多台设备选旗舰版；需要统一管理和定制路由的团队选团队版。</dd>\n        </div>\n        <div class=\"qa\">\n          <dt>“极速流量”用完了会怎样？</dt>\n          <dd>套餐标注的是每月的流量额度（如基础版 100GB）。接近上限时建议留意用量，是否限速或需升级取决于账户实际策略，请以订阅后收到的说明为准。</dd>\n        </div>\n        <div class=\"qa\">\n          <dt>同时在线数超了会发生什么？</dt>\n          <dd>各档有明确的上限：3 / 5 / 20 台。超出后新加入的设备可能无法保持在线，此时需要断开一台旧设备，或升级到更高并发档位。</dd>\n        </div>\n        <div class=\"qa\">\n          <dt>IPLC 专线和普通节点有什么区别？</dt>\n          <dd>本页仅说明旗舰版含“IPLC 专线游戏加速优化”，团队版含“VIP 专属高带宽节点”。它们面向实时性更强的场景；普通线路节点池更适合日常网页与视频。</dd>\n        </div>\n        <div class=\"qa\">\n          <dt>年付比月付划算吗？</dt>\n          <dd>按公开标价折算：基础版 ¥150/年 约等于 10 个月的价格，旗舰版 ¥350/年、团队版 ¥850/年 同理。若确定长期使用，年付一次性支出更低。</dd>\n        </div>\n        <div class=\"qa\">\n          <dt>出问题找谁处理？</dt>\n          <dd>基础版走标准渠道；旗舰版享 7×24 优先工单；团队版配备专属客户经理。遇到问题时，优先尝试更换节点，再按所属档位提交工单。</dd>\n        </div>\n        <div class=\"qa\">\n          <dt>在哪里下载客户端？</dt>\n          <dd>为避免提供未经确认的地址，本页不直接给出下载链接。订阅完成后，请依据官方通知中的说明获取对应平台的安装方式。</dd>\n        </div>\n        <div class=\"qa\">\n          <dt>能中途升级套餐吗？</dt>\n          <dd>可以按需求变更档位，例如从基础版升到旗舰版以获得更大流量与专线优化。具体的差价结算与生效时间，以订单页面的规则为准。</dd>\n        </div>\n      </dl>\n    </div>\n  </section>\n\n</main>\n\n<footer>\n  <div class=\"wrap foot-grid\">\n    <div class=\"foot-brand\">环球<span class=\"dot\">·</span>加速</div>\n    <div class=\"foot-meta\">\n      Cross-border Network Plans<br>\n      套餐 · 用法 · 常见问题 — 内容以本页公开信息为准\n    </div>\n  </div>\n</footer>",
